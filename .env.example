COMMERCE_OS_ENVIRONMENT=development
COMMERCE_OS_DATABASE_URL=postgresql+psycopg://commerce_os:commerce_os@postgres:5432/commerce_os
COMMERCE_OS_REDIS_URL=redis://redis:6379/0
COMMERCE_OS_LOG_LEVEL=INFO
# Required only when activating the read-only Reddit connector.
COMMERCE_OS_REDDIT_CLIENT_ID=
COMMERCE_OS_REDDIT_CLIENT_SECRET=
COMMERCE_OS_REDDIT_USER_AGENT=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
# Temporary server-side dashboard context until the web authentication flow is implemented.
# Use a revocable human session with api.read only; never expose this token as NEXT_PUBLIC_*.
COMMERCE_OS_API_TOKEN=
# Optional safety assertion. When set, it must match the organization returned by /auth/me.
COMMERCE_OS_ORGANIZATION_ID=
# Optional future Shopify server/Worker references. Values stay empty in source control.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
